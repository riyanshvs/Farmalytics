# MongoDB Connection
# Get your free MongoDB Atlas URI from: https://www.mongodb.com/cloud/atlas
# Or use local: mongodb://localhost:27017/farmalytics
MONGODB_URI=mongodb://localhost:27017/farmalytics

# Firebase Admin SDK (service account values)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Hugging Face API Configuration
# Get your free API token from: https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=your_token_here

# GNews API Configuration (backend only)
# Get your free API token from: https://gnews.io/
GNEWS_API_KEY=your_gnews_token_here
GNEWS_BASE_URL=https://gnews.io/api/v4

# News provider selection: auto | datagov | scraper | gnews
# auto = Data.gov first (if configured), then scraper, then GNews fallback
NEWS_PROVIDER=auto

# Data.gov.in API Configuration (backend only)
# Most endpoints follow:
# https://api.data.gov.in/resource/{resource_id}?api-key=...&format=json
DATAGOV_API_KEY=your_datagov_api_key_here
DATAGOV_BASE_URL=https://api.data.gov.in/resource

# Use one generic resource ID OR category-specific resource IDs
DATAGOV_RESOURCE_ID=
DATAGOV_WEATHER_RESOURCE_ID=
DATAGOV_MARKET_RESOURCE_ID=
DATAGOV_TECH_RESOURCE_ID=
DATAGOV_SUCCESS_RESOURCE_ID=
DATAGOV_TIMEOUT_MS=9000

# Scraper API Configuration (backend only)
# Set SCRAPER_NEWS_API_URL to enable your scraper source.
# Example: https://your-scraper.example.com/api/news
SCRAPER_NEWS_API_URL=
SCRAPER_NEWS_API_METHOD=GET
SCRAPER_NEWS_API_KEY=
SCRAPER_NEWS_API_KEY_HEADER=x-api-key
# Optional: use if scraper expects key in query instead of header
SCRAPER_NEWS_API_KEY_QUERY_PARAM=
SCRAPER_NEWS_API_TIMEOUT_MS=9000

# News feed tuning
# 300000 ms = 5 minutes cache TTL
NEWS_CACHE_TTL_MS=300000
# Default max items returned per news request
NEWS_DEFAULT_LIMIT=24

# Server Port (optional, defaults to 5000)
PORT=5000

# Redis-backed durability (optional)
# Set REDIS_URL and switch providers to "redis" for production-grade cache/rate-limit storage.
REDIS_URL=
CACHE_PROVIDER=memory
RATE_LIMIT_PROVIDER=memory
