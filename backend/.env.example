# MongoDB Connection
# Get your free MongoDB Atlas URI from: https://www.mongodb.com/cloud/atlas
# Or use local: mongodb://localhost:27017/farmalytics
MONGODB_URI=mongodb://localhost:27017/farmalytics

# JWT Secret (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Hugging Face API Configuration
# Get your free API token from: https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=your_token_here

# Server Port (optional, defaults to 5000)
PORT=5000
